{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/arctan/dotfiles/Wallpapers/chigiri.png",
        "type": "kitty",
        "padding": {
            "top": 2,
            "left": 1,
            "right": 2
        },
        "width": 25
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "host",
            "key": "pc",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "cpu",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "mem",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": "os",
            "keyColor": "blue"
        },
        // {
        //     "type": "packages",
        //     "key": "│ ├󰏖",
        //     "keyColor": "blue"
        // },
        {
            "type": "shell",
            "key": "sh",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "wm",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "term",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "age",
            "keyColor": "blue",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "up",
            "keyColor": "blue"
        },

        //        {
        //            "type": "colors"
        //        },

        {
            "type": "colors",
            "paddingLeft": 0,
            "symbol": "circle"
        }
    ]
}
