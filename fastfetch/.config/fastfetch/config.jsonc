{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/arctan/dotfiles/Wallpapers/chigiri.png",
        "type": "kitty",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 0
        },
        "width": 25
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "host",
            "key": "    PC",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "    CPU",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "    memory",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": "    OS",
            "keyColor": "blue"
        },
        // {
        //     "type": "packages",
        //     "key": "│ ├󰏖",
        //     "keyColor": "blue"
        // },
        {
            "type": "shell",
            "key": "    shell",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "    WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "    terminal",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "    OS Age ",
            "keyColor": "blue",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "    Uptime ",
            "keyColor": "blue"
        },

        //        {
        //            "type": "colors"
        //        },

        {
            "type": "colors",
            "paddingLeft": 4,
            "symbol": "circle"
        },
        "break"
    ]
}
